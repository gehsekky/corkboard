# Copy to .env (gitignored) and fill in real values.

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5532/db_corkboard?schema=public

# Base URL where this app is reachable (no trailing slash). Provider redirect URIs
# are derived as ${AUTH_CALLBACK_BASE_URL}/auth/<provider>/callback.
AUTH_CALLBACK_BASE_URL=http://localhost:5174

# --- Identity providers ---
# Each provider activates only when its client id + secret are both set.

# Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: ${AUTH_CALLBACK_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict Google sign-in to a specific Google Workspace domain (e.g. example.com).
# GOOGLE_HOSTED_DOMAIN=

# Optional: comma-separated allowlist of email domains permitted to sign in
# (applies across all providers). Leave unset to allow any.
# ALLOWED_EMAIL_DOMAINS=example.com,acme.co

# Optional: set this only if your cookie needs to span subdomains.
# Leave unset in dev; cookies will default to the request host.
# COOKIE_DOMAIN=example.com
